/***********************************************************************

	UNHOLY -- definitions de base des scripts

	Le module de jeu compile ce fichier avant tout autre script : son nom
	est fixe dans le code (d3xp/Game.h, SCRIPT_DEFAULTDEFS). Il porte
	d'ordinaire les constantes qui doivent refleter celles du C++, contenus
	de collision, directions, axes.

	UNHOLY n'y met que ce dont ses scripts ont besoin, et chaque constante y
	est recopiee depuis le C++, jamais depuis les scripts de Doom 3.

***********************************************************************/

#ifndef __DOOM_DEFS__
#define __DOOM_DEFS__

// Le langage n'a pas de booleens litteraux : Doom 3 les definissait ici.
#define	true	1
#define	false	0

#endif
