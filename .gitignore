build/
.DS_Store

# Shaders compiles par le moteur : content/renderprogs2 pointe dessus.
content/renderprogs2

# Sorties de dmap, regenerees a chaque compilation de carte.
content/maps/*.proc
content/maps/*.cm
content/maps/*.aas*

# Caches du moteur : images et cartes converties au premier chargement.
content/generated/

# Cache de Python, laisse par les scripts de cartes.
__pycache__/

# Armes du Retro Weapon Pack, converties sur place par
# tools/assets/build_retro_weapons.sh : le pack ne se redistribue pas.
content/models/retro/
content/textures/retro/

# Le fusil HD : le modele anime porte les animations du pack, et ses textures
# cuites se refont a l'identique (tools/assets/build_hd_weapons.sh).
content/models/hd/
content/textures/unholy/fusil/
